#include <iostream>
#include <vector>
using namespace std;

class ArrayStack {
private:
    vector<int> stack;

public:
    void push(int val) {
        stack.push_back(val);
    }

    int pop() {
        if (stack.empty()) {
            cerr << "Error: Stack underflow!" << endl;
            return -1;
        }
        int val = stack.back();
        stack.pop_back();
        return val;
    }

    int peek() {
        if (stack.empty()) {
            cerr << "Error: Stack is empty!" << endl;
            return -1;
        }
        return stack.back();
    }

    bool isEmpty() {
        return stack.empty();
    }

    void print() {
        cout << "Stack (Top to Bottom): ";
        for (int i = stack.size() - 1; i >= 0; i--) {
            cout << stack[i] << " ";
        }
        cout << endl;
    }
};
