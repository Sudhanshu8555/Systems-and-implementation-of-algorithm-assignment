#include <iostream>
#include <stack>
using namespace std;

class QueueUsingStacks {
private:
    stack<int> s1;
    stack<int> s2;

public:
    void enqueue(int val) {
        s1.push(val);
    }

    int dequeue() {
        if (s2.empty()) {
            while (!s1.empty()) {
                s2.push(s1.top());
                s1.pop();
            }
        }
        if (s2.empty()) {
            cerr << "Error: Queue is empty!" << endl;
            return -1;
        }
        int val = s2.top();
        s2.pop();
        return val;
    }

    int peek() {
        if (s2.empty()) {
            while (!s1.empty()) {
                s2.push(s1.top());
                s1.pop();
            }
        }
        if (s2.empty()) {
            cerr << "Error: Queue is empty!" << endl;
            return -1;
        }
        return s2.top();
    }

    bool isEmpty() {
        return s1.empty() && s2.empty();
    }

    void print() {
        stack<int> temp = s2;
        cout << "Queue (Front to Rear): ";
        while (!temp.empty()) {
            cout << temp.top() << " ";
            temp.pop();
        }
        stack<int> temp2;
        while (!s1.empty()) {
            temp2.push(s1.top());
            s1.pop();
        }
        while (!temp2.empty()) {
            cout << temp2.top() << " ";
            temp2.pop();
        }
        cout << endl;
    }
};
