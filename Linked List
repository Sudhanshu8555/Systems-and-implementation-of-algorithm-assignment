#include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* next;

    Node(int val) : data(val), next(nullptr) {}
};

class LinkedList {
private:
    Node* head;
    int size;

public:
    LinkedList() : head(nullptr), size(0) {}

     ~LinkedList() {
        clear();
    }

    bool isEmpty() {
        return head == nullptr;
    }

     int getSize() {
        return size;
    }

    void prepend(int val) {
        Node* newNode = new Node(val);
        newNode->next = head;
        head = newNode;
        size++;
    }

    void append(int val) {
        Node* newNode = new Node(val);
        if (isEmpty()) {
            head = newNode;
        } else {
            Node* temp = head;
            while (temp->next != nullptr) {
                temp = temp->next;
            }
            temp->next = newNode;
        }
        size++;
    }

    void insertAt(int index, int val) {
        if (index < 0 || index > size) {
            cerr << "Error: Index out of bounds!" << endl;
            return;
        }
        if (index == 0) {
            prepend(val);
        } else if (index == size) {
            append(val);
        } else {
            Node* newNode = new Node(val);
            Node* temp = head;
            for (int i = 0; i < index - 1; i++) {
                temp = temp->next;
            }
            newNode->next = temp->next;
            temp->next = newNode;
            size++;
        }
    }

    void removeFirst() {
        if (isEmpty()) {
            cerr << "Error: List is empty!" << endl;
            return;
        }
        Node* temp = head;
        head = head->next;
        delete temp;
        size--;
    }

    void removeLast() {
        if (isEmpty()) {
            cerr << "Error: List is empty!" << endl;
            return;
        }
        if (head->next == nullptr) {
            delete head;
            head = nullptr;
        } else {
            Node* temp = head;
            while (temp->next->next != nullptr) {
                temp = temp->next;
            }
            delete temp->next;
            temp->next = nullptr;
        }
        size--;
    }

     void removeAt(int index) {
        if (index < 0 || index >= size) {
            cerr << "Error: Index out of bounds!" << endl;
            return;
        }
        if (index == 0) {
            removeFirst();
        } else if (index == size - 1) {
            removeLast();
        } else {
            Node* temp = head;
            for (int i = 0; i < index - 1; i++) {
                temp = temp->next;
            }
            Node* toDelete = temp->next;
            temp->next = temp->next->next;
            delete toDelete;
            size--;
        }
    }

    int search(int val) {
        Node* temp = head;
        int index = 0;
        while (temp != nullptr) {
            if (temp->data == val) {
                return index;
            }
            temp = temp->next;
            index++;
        }
        return -1;
    }

    int get(int index) {
        if (index < 0 || index >= size) {
            cerr << "Error: Index out of bounds!" << endl;
            return -1;
        }
        Node* temp = head;
        for (int i = 0; i < index; i++) {
            temp = temp->next;
        }
        return temp->data;
    }

     void set(int index, int val) {
        if (index < 0 || index >= size) {
            cerr << "Error: Index out of bounds!" << endl;
            return;
        }
        Node* temp = head;
        for (int i = 0; i < index; i++) {
            temp = temp->next;
        }
        temp->data = val;
    }

    void clear() {
        while (!isEmpty()) {
            removeFirst();
        }
    }

     void print() {
        Node* temp = head;
        while (temp != nullptr) {
            cout << temp->data << " -> ";
            temp = temp->next;
        }
        cout << "NULL" << endl;
    }
};
