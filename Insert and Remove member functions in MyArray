#include <iostream>
using namespace std;

class myArray {
private:
    int* arr;       
    int capacity;   
    int size;      
public:
   
    myArray() : capacity(10), size(0) {
        arr = new int[capacity];
    }

   
    ~myArray() {
        delete[] arr;
    }

    void resize() {
        capacity *= 2;
        int* newArr = new int[capacity];
        for (int i = 0; i < size; i++) {
            newArr[i] = arr[i];
        }
        delete[] arr;
        arr = newArr;
    }

   
    void insert(int index, int value) {
        if (index < 0 || index > size) {
            cerr << "Error: Index out of bounds!" << endl;
            return;
        }

        
        if (size == capacity) {
            resize();
        }

        
        for (int i = size; i > index; i--) {
            arr[i] = arr[i - 1];
        }

        arr[index] = value;
        size++;
    }

      void remove(int index) {
        if (index < 0 || index >= size) {
            cerr << "Error: Index out of bounds!" << endl;
            return;
        }

        for (int i = index; i < size - 1; i++) {
            arr[i] = arr[i + 1];
        }

        size--;
    }

    void print() {
        for (int i = 0; i < size; i++) {
            cout << arr[i] << " ";
        }
        cout << endl;
    }
};

int main() {
    myArray arr;

    // Insert elements
    arr.insert(0, 10);  // [10]
    arr.insert(1, 20);  // [10, 20]
    arr.insert(1, 15);  // [10, 15, 20]
    arr.insert(3, 30);  // [10, 15, 20, 30]

    cout << "After insertions: ";
    arr.print();  // Output: 10 15 20 30

    // Remove elements
    arr.remove(1);  // Removes 15 → [10, 20, 30]
    arr.remove(2);  // Removes 30 → [10, 20]

    cout << "After removals: ";
    arr.print();  // Output: 10 20

    return 0;
}
