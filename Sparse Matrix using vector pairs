#include <iostream>
#include <vector>
#include <utility>
using namespace std;

class SparseMatrix {
private:
    vector<pair<pair<int, int>, int>> elements;
    int rows;
    int cols;

public:
    SparseMatrix(int r, int c) : rows(r), cols(c) {}

    void set(int i, int j, int val) {
        if (val != 0) {
            elements.push_back({{i, j}, val});
        }
    }

    int get(int i, int j) {
        for (const auto& elem : elements) {
            if (elem.first.first == i && elem.first.second == j) {
                return elem.second;
            }
        }
        return 0;
    }

    void print() {
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                cout << get(i, j) << " ";
            }
            cout << endl;
        }
    }
};
